n  {%- when 'de' -%}\n    {%- assign bc_label = 'Kategorie:' -%}\n  {%- when 'nl' -%}\n    {%- assign bc_label = 'Categorie:' -%}\n  {%- when 'fr' -%}\n    {%- assign bc_label = 'Catégorie:' -%}\n  {%- when 'es' -%}\n    {%- assign bc_label = 'Categoría:' -%}\n  {%- when 'it' -%}\n    {%- assign bc_label = 'Categoria:' -%}\n  {%- when 'sv-se' -%}\n    {%- assign bc_label = 'Kategori:' -%}\n  {%- when 'da-dk' -%}\n    {%- assign bc_label = 'Kategori:' -%}\n  {%- when 'no' -%}\n    {%- assign bc_label = 'Kategori:' -%}\n{%- endcase -%}\n\n<div class=\"breadcrumbs-wrap\">\n  <nav class=\"breadcrumbs\" aria-label=\"Breadcrumb\">\n    <span class=\"breadcrumbs__label\">{{ bc_label }}<\/span>\n\n    <ol class=\"breadcrumbs__list\" role=\"list\">\n      <li class=\"breadcrumbs__item\">\n        <span class=\"breadcrumbs__current\" aria-current=\"page\">\n          {{ collection.title }}\n        <\/span>\n      <\/li>\n    <\/ol>\n  <\/nav>\n<\/div>\n\n<script type=\"application\/ld+json\">\n{\n  \"@context\": \"https:\/\/schema.org\",\n  \"@type\": \"BreadcrumbList\",\n  \"itemListElement\": [\n    {\n      \"@type\": \"ListItem\",\n      \"position\": 1,\n      \"name\": {{ collection.title | json }},\n      \"item\": \"{{ shop.url }}{{ collection.url }}\"\n    }\n  ]\n}\n<\/script>\n\n<style>\n  .breadcrumbs-wrap {\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 0;\n  }\n\n  \/* Mobile padding like Dawn *\/\n  @media screen and (max-width: 749px) {\n    .breadcrumbs-wrap {\n      padding-left: 2rem;\n      padding-right: 2rem;\n    }\n  }\n\n  .breadcrumbs {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    margin: 0;\n    padding: 0;\n\n    font-family: inherit;\n    font-size: 16px;       \/* SAME everywhere *\/\n    font-weight: 400;      \/* SAME everywhere *\/\n    line-height: 1.2;\n    color: #BF1E2D;\n  }\n\n  .breadcrumbs__label {\n    font-size: 16px;       \/* SAME *\/\n    font-weight: 400;      \/* SAME *\/\n    opacity: 1;          \/* only visual distinction *\/\n    white-space: nowrap;\n  }\n\n  .breadcrumbs__list {\n    display: flex;\n    gap: 8px;\n    padding: 0;\n    margin: 0;\n    list-style: none;\n  }\n\n  .breadcrumbs__current {\n    font-size: 16px;       \/* SAME *\/\n    font-weight: 400;      \/* SAME *\/\n    color: #BF1E2D;\n  }\n<\/style>","color_scheme":"","padding_top":16,"padding_bottom":0}},"image_with_text_Y4fpWL":{"type":"image-with-text","blocks":{"heading_JxRfmp":{"type":"heading","settings":{"heading":"<strong>Fender brochures<\/strong>","heading_size":"h2"}},"text_gUXrFr":{"type":"text","settings":{"text":"<p>In our <a href=\"https:\/\/unbaae-js.myshopify.com\/pages\/downloads\" title=\"Rubber fender brochures:\">download section<\/a> you will find the latest editions of our fender brochures. Please download our latest fender catalogue for more interesting product information.<\/p>","text_style":"body"}},"button_XBa9Wz":{"type":"button","settings":{"button_label":"VIEW BROCHURES","button_link":"shopify:\/\/pages\/brochures","button_style_secondary":false}}},"block_order":["heading_JxRfmp","text_gUXrFr","button_XBa9Wz"],"custom_css":[],"settings":{"image":"shopify:\/\/shop_images\/downloads-home-bg_0.png","height":"adapt","desktop_image_width":"medium","layout":"text_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","section_color_scheme":"","color_scheme":"","image_behavior":"none","mobile_content_alignment":"left","padding_top":16,"padding_bottom":16}}},"order":["image_banner_YhLHJP","rich_text_aLBbjR","product-grid","collection_list_NN6VJU","collection_list_F4CcrL","collection_list_JGy9zA","collection_list_CBgiL9","collection_list_RCbcCH","collection_list_XDUpqe","banner","custom_liquid_QBKR4C","image_with_text_Y4fpWL"]}