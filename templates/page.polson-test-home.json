s":["h3 {color: #004a97; font-size: 30px;}",".button {color: white; background: #004a97; border-color: #004a97;}","p {color: #1d1d1b;}","a {color: #004a97; text-decoration: none; \/* Optioneel: verwijdert de onderstreping *\/}","a:hover {text-decoration: underline; \/* Optioneel: voegt een onderstreping toe bij hover *\/}"],"settings":{"title":"","heading_size":"h1","image_width":"full","image_ratio":"adapt","columns_desktop":3,"column_alignment":"left","background_style":"primary","button_label":"","button_link":"","color_scheme":"","columns_mobile":"1","swipe_on_mobile":false,"padding_top":20,"padding_bottom":20}},"rich_text_rdr8QP":{"type":"rich-text","blocks":{"heading_GFdKip":{"type":"heading","disabled":true,"settings":{"heading":"Talk about your brand","heading_size":"h1"}},"text_eFNMAH":{"type":"text","disabled":true,"settings":{"text":"<p>Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.<\/p>"}},"button_WPrt9A":{"type":"button","disabled":true,"settings":{"button_label":"Button label","button_link":"","button_style_secondary":false,"button_label_2":"","button_link_2":"","button_style_secondary_2":false}}},"block_order":["heading_GFdKip","text_eFNMAH","button_WPrt9A"],"settings":{"desktop_content_position":"center","content_alignment":"center","color_scheme":"scheme-2","full_width":false,"padding_top":0,"padding_bottom":4}},"rich_text_YgjGrH":{"type":"rich-text","blocks":{"heading_BPfwEF":{"type":"heading","settings":{"heading":"Polson Technisch rubber & Kunststof oplossingen","heading_size":"h1"}},"text_taWddb":{"type":"text","settings":{"text":"<p>Polson, opgericht in 1963 en gevestigd in Papendrecht, startte met het aanbieden van autobanden en groeide al snel uit tot een betrouwbare fabrikant en leverancier van technisch rubber en kunststof producten. Sindsdien heeft Polson een uitgebreid assortiment aan rubber- en kunststofproducten ontwikkeld, waaronder rubber pakkingen en afdichtingen, rubber profielen, rubbervormwerk, rubber fenders en stootranden.<\/p><p>Dankzij onze centrale ligging zijn wij gemakkelijk bereikbaar en hebben wij korte distributielijnen naar alle industriële centra in Nederland. Met meer dan 60 jaar ervaring in het meedenken over oplossingen op het gebied van technisch rubber en kunststoffen, zijn wij in staat om snelle maatwerkoplossingen te leveren en onze klanten optimaal van dienst te zijn.<\/p><p>Naast de standaard technisch rubber- en kunststofproducten bestaat een belangrijk deel van ons leveringspakket uit op maat vervaardigde producten volgens de specificaties van onze klanten. Polson is onder meer specialist in het op maat maken van pakkingen, afdichtingen en rubber profielen, die in onze eigen fabriek in Papendrecht worden geproduceerd met indien gewenst korte levertijden.<\/p>"}}},"block_order":["heading_BPfwEF","text_taWddb"],"custom_css":["h2 {color: #004a97;}",".button {background: #004a97; border-color: #004a97;}","p {color: #1d1d1b;}"],"settings":{"desktop_content_position":"center","content_alignment":"center","color_scheme":"","full_width":true,"padding_top":20,"padding_bottom":40}}},"order":["image_banner_FFUz3g","main","image_with_text_ayi7WD","image_with_text_BxqPh7","multicolumn_4BaG3m","collection_list_MTPa8r","rich_text_9YJbjw","image_with_text_mkjYWT","image_with_text_6c9WjF","multicolumn_A3KfHp","rich_text_rdr8QP","rich_text_YgjGrH"]}