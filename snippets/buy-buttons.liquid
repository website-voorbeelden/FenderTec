{% doc %}
  Renders FenderTec's product quotation form in sections with a buy-buttons block.
  @param {product} product - Product included in the quotation
  @param {block} [block] - Section block used by the theme editor
  @param {string} section_id - Unique ID of the product section
{% enddoc %}
{%- if product != blank -%}
  {% render 'yokohama-product-contact', product: product, block: block, section_id: section_id %}
{%- endif -%}
