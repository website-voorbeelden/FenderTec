  <script>
  (function() {
    if (window.Shopify && Shopify.designMode) return;

    // Functionele params die jemag houden (pas aan op jouw thema)
    const keep = new Set(["q","page","sort_by","view","variant","options","color","size","pf_t_material","pf_t_color"]);

// Tracking/marketing/debug die je wilt verwijderen
const drop = new Set([
  "_gl","_ga","_ga_8D45W78N5Z","_ga_Q7ER7GZEQS",
  "gbraid","wbraid",
  "utm_source","utm_medium","utm_campaign","utm_term","utm_content","utm_id",
  "fbclid","msclkid","ttclid","yclid",
  "gtm_debug","gtm_preview","gtm_auth","gtm_cookies_win",
  "shpxid" // ✅ Shopify param veilig verwijderen
]);


    function cleanUrl() {
      try {
        if (!location.search) return;

        const url = new URL(location.href);
        let changed = false;

        // Verwijder alle bekende trackingparams
        for (const [key] of url.searchParams) {
          if (drop.has(key)) {
            url.searchParams.delete(key);
            changed = true;
          }
        }

        // Optioneel: verwijder ALLES wat niet in keep staat (hard clean)
        // (Zet dit AAN als je zeker weet dat je geen andere functionele params gebruikt)
        for (const [key] of Array.from(url.searchParams.keys())) {
          if (!keep.has(key) && drop.has(key) === false) {
            // comment deze regel UIT om alles niet-essentieel te strippen:
            // url.searchParams.delete(key), changed = true;
          }
        }

        if (changed) {
          const qs = url.searchParams.toString();
          history.replaceState(null, document.title, url.pathname + (qs ? "?" + qs : "") + url.hash);
        }
      } catch (e) {}
    }

    // Draai na echt alles: scripts, styles, apps
    window.addEventListener('load', function() {
      // 1e keer direct
      cleanUrl();
      // fallback: als iets ná load alsnog decoreert, probeer nog eens kort erna
      setTimeout(cleanUrl, 250);
      setTimeout(cleanUrl, 1500);
    });
  })();
</script>

<!-- Fendertec: nette mailto tracking zonder subject -->
<script id="ft-mailto-tracking">
(function(){
  try{
    if (window.Shopify && Shopify.designMode) return;

    // 1) Capture UTM/GCLID and store as JSON
    (function(){
      var p = new URLSearchParams(location.search || "");
      var keys = ["utm_source","utm_medium","utm_campaign","utm_term","utm_content","gclid"];
      var o = {}, has = false;
      keys.forEach(function(k){
        var v = p.get(k);
        if (v) { o[k] = v; has = true; }
      });
      if (has) localStorage.setItem("ft_attrib", JSON.stringify(o));
    })();

    // Helper: safely read attribution JSON
    function ftAttrib(){
      try { return JSON.parse(localStorage.getItem("ft_attrib") || "{}"); }
      catch(e){ return {}; }
    }

    // 2) Build improved mailto
    function upgradeMailto(href){
      try{
        if (!href || href.indexOf("mailto:") !== 0) return href;
        if (href.indexOf("ft=1") > -1) return href; // avoid duplicates

        var url = new URL(href);
        url.searchParams.delete("subject"); // ✅ geen onderwerp

        var body = url.searchParams.get("body") || "";
        var a = ftAttrib();

        // ✅ 20 lege regels + nette scheiding
        var tail =
          "\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n---\n" +
          "Page: " + location.href +
          (a.utm_source  ? "\nSource: "  + a.utm_source  : "") +
          (a.utm_medium  ? "\nMedium: "  + a.utm_medium  : "") +
          (a.utm_campaign? "\nCampaign: "  + a.utm_campaign: "") +
          (a.gclid       ? "\nGCLID: " + a.gclid       : "");

        if (body.indexOf("Page: ") === -1) {
          body = (body ? body.trim() + "\n\n" : "") + tail;
        }

        url.searchParams.set("body", body);
        url.searchParams.set("ft", "1");
        return url.toString();
      } catch(e){ return href; }
    }

    // 3) Apply on all mailto clicks
    document.addEventListener("click", function(e){
      var a = e.target && e.target.closest && e.target.closest('a[href^="mailto:"]');
      if (!a || a.dataset.noTrack === "true") return;
      a.setAttribute("href", upgradeMailto(a.getAttribute("href")));
    }, true);
  }catch(e){}
})();
</script>


<script>
(function(){
  try{
    if (window.Shopify && Shopify.designMode) return;

    // Lees UTM/GCLID uit localStorage (zoals je mailto-script zet) + fallback uit URL
    function getAttrib(){
      var o = {};
      try { o = JSON.parse(localStorage.getItem('ft_attrib') || '{}') || {}; } catch(e){}
      var q = new URLSearchParams(location.search || '');
      ['utm_source','utm_medium','utm_campaign','utm_term','utm_content','gclid'].forEach(function(k){
        if (!o[k] && q.get(k)) o[k] = q.get(k);
      });
      return o;
    }

    // Bouw nette tail (NL labels). Voeg alleen regels toe die er zijn.
    function buildTail(){
      var a = getAttrib(), L = [];
      // 12 lege regels: duidelijk onderaan, niet extreem
      var pad = '\n\n\n\n\n\n\n\n\n\n\n\n';
      L.push('—');
      L.push('Pagina: ' + location.href);
      if (a.utm_source)   L.push('Bron: '     + a.utm_source);
      if (a.utm_medium)   L.push('Medium: '   + a.utm_medium);
      if (a.utm_campaign) L.push('Campagne: ' + a.utm_campaign);
      if (a.utm_term)     L.push('Term: '     + a.utm_term);
      if (a.utm_content)  L.push('Content: '  + a.utm_content);
      if (a.gclid)        L.push('GCLID: '    + a.gclid);
      return pad + L.join('\n');
    }

    function hidden(name, val){
      var i = document.createElement('input');
      i.type = 'hidden';
      i.name = name;
      i.value = val || '';
      return i;
    }

    function onReady(fn){
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn);
      else fn();
      document.addEventListener('shopify:section:load', fn);
      document.addEventListener('shopify:section:select', fn);
    }

    onReady(function enhance(){
      var form = document.querySelector('#ContactForm'); // Dawn-standaard
      if (!form || form.dataset.ftContactAug === '1') return;

      form.addEventListener('submit', function(){
        // 1) Haal de gebruikersboodschap op (werkt ook als je het veld vertaald hebt)
        var userMsgEl =
          form.querySelector('#ContactForm-body') ||
          form.querySelector('textarea[name="contact[body]"]') ||
          form.querySelector('textarea[name^="contact["]');
        var userMsg = userMsgEl ? (userMsgEl.value || '') : '';

        // 2) Bouw de definitieve body en forceer als contact[body]
        var tail = buildTail();
        // dubbele append voorkomen: als tail al aanwezig is, niets toevoegen
        var finalBody = /\nPagina:\s|^Pagina:\s/m.test(userMsg) ? userMsg : (userMsg ? userMsg.trim() + '\n\n' : '') + tail;

        // Als de originele textarea al contact[body] heet: overschrijf value
        if (userMsgEl && userMsgEl.name === 'contact[body]') {
          userMsgEl.value = finalBody;
        } else {
          // anders: verwijder eventuele oude contact[body] en voeg hidden toe
          var old = form.querySelector('input[name="contact[body]"], textarea[name="contact[body]"]');
          if (old && old !== userMsgEl) old.parentNode.removeChild(old);
          form.appendChild(hidden('contact[body]', finalBody));
        }

        // 3) Losse velden voor "Additional details" (alleen toevoegen wat er is)
        var a = getAttrib();
        form.appendChild(hidden('contact[Pagina]', location.href));
        if (a.utm_source)   form.appendChild(hidden('contact[UTM Bron]', a.utm_source));
        if (a.utm_medium)   form.appendChild(hidden('contact[UTM Medium]', a.utm_medium));
        if (a.utm_campaign) form.appendChild(hidden('contact[UTM Campagne]', a.utm_campaign));
        if (a.utm_term)     form.appendChild(hidden('contact[UTM Term]', a.utm_term));
        if (a.utm_content)  form.appendChild(hidden('contact[UTM Content]', a.utm_content));
        if (a.gclid)        form.appendChild(hidden('contact[GCLID]', a.gclid));
      }, true);

      form.dataset.ftContactAug = '1';
    });
  }catch(e){}
})();
</script>


    
