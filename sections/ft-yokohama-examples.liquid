<style>
.ft-yoko-examples{padding-top:32px;padding-bottom:32px}
.ft-yoko-examples>h2{margin:0 0 24px}
.ft-yoko-examples__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
.ft-yoko-examples article{min-width:0;display:flex;flex-direction:column;background:#f6f5f3;border:1px solid #e6e3e1;overflow:hidden}
.ft-yoko-examples article>img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover}
.ft-yoko-examples__copy{display:flex;flex-direction:column;align-items:flex-start;flex:1;padding:24px}
.ft-yoko-examples__copy h3{margin:0 0 14px}
.ft-yoko-examples__copy p{margin:0 0 16px}
.ft-yoko-examples__copy p:last-child{margin-bottom:0}
.ft-yoko-examples__copy a{color:var(--ft-brand-red)}
@media(max-width:749px){.ft-yoko-examples{padding-top:24px;padding-bottom:24px}.ft-yoko-examples__grid{grid-template-columns:minmax(0,1fr);gap:32px}}
</style>
<style>@media(min-width:750px) and (max-width:989px){.ft-yoko-examples__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:749px){.ft-yoko-examples__copy{padding:20px}}</style>

