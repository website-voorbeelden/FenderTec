{% if theme.role == 'development' and request.locale.iso_code == 'en' %}
<script>
  (() => {
    const current = new URL(window.location.href);
    const region = current.searchParams.get('stock_region');
    if (region !== 'nl' && region !== 'de') return;

    const link = document.querySelector('a[data-preview-language][hreflang="' + region + '"]');
    if (!link) return;

    const destination = new URL(link.href);
    current.searchParams.delete('stock_region');
    current.searchParams.set('view', 'yokohama-fender');
    destination.search = current.search;
    destination.hash = current.hash;
    window.location.replace(destination.href);
  })();
</script>
{% endif %}

