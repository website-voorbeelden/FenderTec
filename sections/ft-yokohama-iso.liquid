<section class="ft-yoko-usps page-width" aria-labelledby="ft-yoko-usps-heading-{{ section.id }}">
  <div class="ft-yoko-usps__layout">
    <div class="ft-yoko-usps__image">
      <img src="{{ 'yokohama-fender-pressure-test.webp' | asset_url }}" alt="{% if request.locale.iso_code == 'da' or request.locale.iso_code == 'en' or request.locale.iso_code == 'de' or request.locale.iso_code == 'fr' or request.locale.iso_code == 'es' or request.locale.iso_code == 'it' or request.locale.iso_code == 'nl' or request.locale.iso_code == 'nb' or request.locale.iso_code == 'sv' %}{{ 'fendertec_yokohama.iso.image_alt' | t }}{% else %}{{ section.settings.image_alt | escape }}{% endif %}" width="1555" height="1011" loading="lazy" decoding="async">
    </div>
    <div class="ft-yoko-usps__copy">
      <h2 class="h2" id="ft-yoko-usps-heading-{{ section.id }}">{% if request.locale.iso_code == 'da' or request.locale.iso_code == 'en' or request.locale.iso_code == 'de' or request.locale.iso_code == 'fr' or request.locale.iso_code == 'es' or request.locale.iso_code == 'it' or request.locale.iso_code == 'nl' or request.locale.iso_code == 'nb' or request.locale.iso_code == 'sv' %}{{ 'fendertec_yokohama.iso.heading' | t }}{% else %}{{ section.settings.heading | escape }}{% endif %}</h2>
      <ul>
        <li><span class="ft-yoko-usps__star" aria-hidden="true">{{ 'icon-star.svg' | inline_asset_content }}</span><span>{% if request.locale.iso_code == 'da' or request.locale.iso_code == 'en' or request.locale.iso_code == 'de' or request.locale.iso_code == 'fr' or request.locale.iso_code == 'es' or request.locale.iso_code == 'it' or request.locale.iso_code == 'nl' or request.locale.iso_code == 'nb' or request.locale.iso_code == 'sv' %}{{ 'fendertec_yokohama.iso.benefit_1' | t }}{% else %}{{ section.settings.benefit_1 | escape }}{% endif %}</span></li>
        <li><span class="ft-yoko-usps__star" aria-hidden="true">{{ 'icon-star.svg' | inline_asset_content }}</span><span>{% if request.locale.iso_code == 'da' or request.locale.iso_code == 'en' or request.locale.iso_code == 'de' or request.locale.iso_code == 'fr' or request.locale.iso_code == 'es' or request.locale.iso_code == 'it' or request.locale.iso_code == 'nl' or request.locale.iso_code == 'nb' or request.locale.iso_code == 'sv' %}{{ 'fendertec_yokohama.iso.benefit_2' | t }}{% else %}{{ section.settings.benefit_2 | escape }}{% endif %}</span></li>
        <li><span class="ft-yoko-usps__star" aria-hidden="true">{{ 'icon-star.svg' | inline_asset_content }}</span><span>{% if request.locale.iso_code == 'da' or request.locale.iso_code == 'en' or request.locale.iso_code == 'de' or request.locale.iso_code == 'fr' or request.locale.iso_code == 'es' or request.locale.iso_code == 'it' or request.locale.iso_code == 'nl' or request.locale.iso_code == 'nb' or request.locale.iso_code == 'sv' %}{{ 'fendertec_yokohama.iso.benefit_3' | t }}{% else %}{{ section.settings.benefit_3 | escape }}{% endif %}</span></li>
        <li><span class="ft-yoko-usps__star" aria-hidden="true">{{ 'icon-star.svg' | inline_asset_content }}</span><span>{% if request.locale.iso_code == 'da' or request.locale.iso_code == 'en' or request.locale.iso_code == 'de' or request.locale.iso_code == 'fr' or request.locale.iso_code == 'es' or request.locale.iso_code == 'it' or request.locale.iso_code == 'nl' or request.locale.iso_code == 'nb' or request.locale.iso_code == 'sv' %}{{ 'fendertec_yokohama.iso.benefit_4' | t }}{% else %}{{ section.settings.benefit_4 | escape }}{% endif %}</span></li>
      </ul>
    </div>
    <div class="ft-yoko-usps__badge"><img src="{{ 'iso-17357.png' | asset_url }}" alt="ISO 17357" width="625" height="626" loading="lazy" decoding="async"></div>
  </div>
{% if section.settings.details != blank %}<div class="rte ft-yoko-iso-details">{% if request.locale.iso_code == 'da' or request.locale.iso_code == 'en' or request.locale.iso_code == 'de' or request.locale.iso_code == 'fr' or request.locale.iso_code == 'es' or request.locale.iso_code == 'it' or request.locale.iso_code == 'nl' or request.locale.iso_code == 'nb' or request.locale.iso_code == 'sv' %}{{ 'fendertec_yokohama.iso.details_html' | t }}{% else %}{{ section.settings.details }}{% endif %}</div>{% endif %}
</section>
<style>
#MainContent #shopify-section-{{ section.id }}{margin-top:64px;margin-bottom:0}
.ft-yoko-usps__layout{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1.7fr);gap:48px;align-items:center}
.ft-yoko-usps__image{display:flex;justify-content:center;align-items:center}
.ft-yoko-usps__image img{display:block;width:100%;max-width:220px;height:auto;object-fit:contain}
.ft-yoko-usps__copy h2{margin:0 0 24px}
.ft-yoko-usps__copy ul{margin:0;padding-left:1.3em}
.ft-yoko-usps__copy li{padding-left:4px}
.ft-yoko-usps__copy li+li{margin-top:12px}
@media(max-width:749px){
#MainContent #shopify-section-{{ section.id }}{margin-top:40px}
.ft-yoko-usps__layout{grid-template-columns:minmax(0,1fr);gap:24px}
.ft-yoko-usps__image img{max-width:150px}
.ft-yoko-usps__copy h2{margin-bottom:20px}
.ft-yoko-usps__copy li+li{margin-top:10px}
}
</style>

<style>
.ft-yoko-usps__layout{grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:40px}
.ft-yoko-usps__image img{max-width:none;width:100%;height:auto}
.ft-yoko-usps__heading{display:grid;grid-template-columns:76px minmax(0,1fr);align-items:center;gap:20px;margin-bottom:24px}
.ft-yoko-usps__heading>img{display:block;width:76px;height:auto;object-fit:contain}
.ft-yoko-usps__heading h2{margin:0}
@media(max-width:749px){.ft-yoko-usps__layout{grid-template-columns:minmax(0,1fr);gap:24px}.ft-yoko-usps__heading{grid-template-columns:64px minmax(0,1fr);gap:16px;margin-bottom:20px}.ft-yoko-usps__heading>img{width:64px}.ft-yoko-usps__heading h2{margin:0}}
</style>

<style>
.ft-yoko-usps__layout{grid-template-columns:minmax(0,.9fr) minmax(0,1.5fr) 110px;gap:28px}
.ft-yoko-usps__image img{max-width:360px}
.ft-yoko-usps__copy ul{list-style:none;padding:0}
.ft-yoko-usps__copy li{display:grid;grid-template-columns:20px minmax(0,1fr);align-items:start;gap:12px;padding:0}
.ft-yoko-usps__copy li+li{margin-top:16px}
.ft-yoko-usps__star{display:flex;align-items:center;min-height:1.7em;color:var(--ft-brand-red)}
.ft-yoko-usps__star svg{display:block;width:18px;height:18px}
.ft-yoko-usps__badge img{display:block;width:110px;height:auto;object-fit:contain}
@media(max-width:989px) and (min-width:750px){.ft-yoko-usps__layout{grid-template-columns:minmax(0,.8fr) minmax(0,1.5fr) 85px;gap:20px}.ft-yoko-usps__badge img{width:85px}}
@media(max-width:749px){.ft-yoko-usps__layout{grid-template-columns:minmax(0,1fr);gap:24px}.ft-yoko-usps__image img{max-width:320px}.ft-yoko-usps__badge{justify-self:center}.ft-yoko-usps__badge img{width:85px}.ft-yoko-usps__copy li+li{margin-top:14px}}
</style>

<style>
@media(min-width:750px){
.ft-stock-gallery__grid--map,.ft-yoko-usps__layout{--ft-location-column:calc((100% - 30px)/3)}
.ft-yoko-usps__layout{grid-template-columns:minmax(0,var(--ft-location-column)) minmax(0,1fr) 110px;gap:28px;align-items:center}
.ft-yoko-usps__image{align-self:stretch;min-height:260px;padding-right:16px;box-sizing:border-box}
.ft-yoko-usps__image img{display:block;width:100%;max-width:none;height:100%;object-fit:contain;object-position:center}
}
@media(min-width:750px) and (max-width:989px){.ft-yoko-usps__layout{grid-template-columns:minmax(0,var(--ft-location-column)) minmax(0,1fr) 85px;gap:20px}}
@media(max-width:749px){.ft-yoko-usps__image{width:100%;padding:0;min-height:0}.ft-yoko-usps__image img{width:100%;max-width:none;height:auto}}
</style>

<style>
.ft-yoko-usps__star{color:rgb(var(--color-foreground));fill:rgb(var(--color-foreground))}
.ft-yoko-usps__star svg{fill:rgb(var(--color-foreground))}
@media(min-width:750px){
.ft-yoko-usps__image{width:calc(100% + 10px);padding-right:0}
.ft-yoko-usps__image img{width:100%;max-width:none}
}
</style>

<style>
@media(min-width:750px){.ft-yoko-usps__layout{grid-template-columns:minmax(0,var(--ft-location-column)) minmax(0,1fr);gap:28px}}
.ft-yoko-usps__heading{grid-template-columns:minmax(0,1fr) 76px;gap:20px;align-items:center;margin-bottom:24px}
.ft-yoko-usps__heading h2{margin:0}
.ft-yoko-usps__heading>img{width:76px;height:auto}
@media(max-width:749px){.ft-yoko-usps__layout{grid-template-columns:minmax(0,1fr)}.ft-yoko-usps__heading{grid-template-columns:minmax(0,1fr) 64px;gap:16px;margin-bottom:20px}.ft-yoko-usps__heading>img{width:64px}}
</style>

<style>
.ft-yoko-usps__star,.ft-yoko-usps__star svg{color:rgb(var(--color-button));fill:rgb(var(--color-button))}
@media(min-width:990px){.ft-yoko-usps__layout{grid-template-columns:minmax(0,var(--ft-location-column)) minmax(0,1fr) 130px;gap:28px}.ft-yoko-usps__badge img{width:130px}}
@media(min-width:750px) and (max-width:989px){.ft-yoko-usps__layout{grid-template-columns:minmax(0,var(--ft-location-column)) minmax(0,1fr) 100px;gap:20px}.ft-yoko-usps__badge img{width:100px}}
@media(max-width:749px){.ft-yoko-usps__layout{grid-template-columns:minmax(0,1fr)}.ft-yoko-usps__badge img{width:100px}}
</style>

<style>
@media(min-width:750px){.ft-yoko-usps__copy{padding-left:20px;min-width:0}}
.ft-yoko-usps__copy li{grid-template-columns:24px minmax(0,1fr)}
.ft-yoko-usps__star svg{width:23px;height:23px}
</style>
<style>.ft-yoko-iso-details{margin-top:24px;max-width:85ch}</style>
{% schema %}
{
  "name": "Yokohama ISO and benefits",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "benefit_1",
      "label": "Benefit 1"
    },
    {
      "type": "text",
      "id": "benefit_2",
      "label": "Benefit 2"
    },
    {
      "type": "text",
      "id": "benefit_3",
      "label": "Benefit 3"
    },
    {
      "type": "text",
      "id": "benefit_4",
      "label": "Benefit 4"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt"
    },
    {
      "type": "richtext",
      "id": "details",
      "label": "Technical explanation"
    }
  ]
}
{% endschema %}
