<style>
.ft-size-tabs{padding-top:24px;padding-bottom:32px}
.ft-size-tabs>h2{margin:0 0 20px}
.ft-size-tabs__buttons{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:20px}
.ft-size-tabs__buttons button{font:inherit;color:inherit;padding:10px 18px;border:1px solid #dedbd8;background:white;border-radius:3px;cursor:pointer}
.ft-size-tabs__buttons button[aria-selected="true"]{background:#f0ad4e;border-color:#f0ad4e;color:#fff}
.ft-size-tabs [hidden]{display:none!important}
.ft-size-tabs__table{overflow-x:auto;margin-bottom:16px;-webkit-overflow-scrolling:touch}
.ft-size-tabs table{width:100%;border-collapse:collapse;background:white;margin:0;box-shadow:none}
.ft-size-tabs th,.ft-size-tabs td{padding:10px 14px;border:1px solid #ddd;text-align:center;white-space:nowrap}
.ft-size-tabs thead{background:#f3f3f3}
.ft-size-tabs tbody tr:nth-child(even){background:#fafafa}
.ft-size-tabs button:focus-visible,.ft-size-tabs [role="tabpanel"]:focus-visible{outline:2px solid #f0ad4e;outline-offset:3px}
@media(max-width:749px){.ft-size-tabs{padding-top:20px;padding-bottom:24px}.ft-size-tabs__buttons{gap:8px}.ft-size-tabs__buttons button{padding:10px 12px}.ft-size-tabs th,.ft-size-tabs td{padding:8px 10px}}
</style>
<script>
(()=>{
const root=document.getElementById('ft-size-tabs-{{ section.id }}');if(!root||root.dataset.ready)return;root.dataset.ready='true';
const tabs=[...root.querySelectorAll('[role="tab"]')],panels=[...root.querySelectorAll('[role="tabpanel"]')];
function select(index,focus=false){tabs.forEach((tab,i)=>{tab.setAttribute('aria-selected',String(i===index));tab.tabIndex=i===index?0:-1;panels[i].hidden=i!==index});if(focus)tabs[index].focus();}
select(0);
tabs.forEach((tab,index)=>{tab.addEventListener('click',()=>select(index));tab.addEventListener('keydown',event=>{let next=index;if(event.key==='ArrowRight')next=(index+1)%tabs.length;else if(event.key==='ArrowLeft')next=(index+tabs.length-1)%tabs.length;else if(event.key==='Home')next=0;else if(event.key==='End')next=tabs.length-1;else return;event.preventDefault();select(next,true)});});
})();
</script>
