<script>
(()=>{
const root=document.getElementById('ft-size-tabs-{{ section.id }}');if(!root)return;
const tables=[...root.querySelectorAll('.ft-size-tabs__table table')],reference=tables[0];if(!reference)return;
function matchWidths(){
const cells=[...reference.querySelectorAll('thead tr:first-child th')];if(cells.length!==4)return;
const widths=cells.map(cell=>cell.getBoundingClientRect().width);if(widths.some(width=>!width))return;
tables.forEach(table=>{let group=table.querySelector('colgroup');if(!group){group=document.createElement('colgroup');table.insertBefore(group,table.firstChild)}group.replaceChildren(...widths.map(width=>{const col=document.createElement('col');col.style.width=width+'px';return col}));table.style.tableLayout='fixed';table.style.width=widths.reduce((sum,width)=>sum+width,0)+'px';});
}
requestAnimationFrame(matchWidths);
if('ResizeObserver'in window)new ResizeObserver(()=>{if(!reference.closest('[role="tabpanel"]').hidden){tables.forEach(table=>{table.style.tableLayout='auto';table.style.width='100%';table.querySelector('colgroup')?.remove()});matchWidths();}}).observe(root);
})();
</script>

