<script>
// ft-yoko-brochure-alignment
(()=>{
function init(){
 const reference=document.querySelector('.ft-yoko-usps__image img');
 const brochure=document.querySelector('.ft-brochure-specs .ft-yoko-brochures');
 if(!reference||!brochure)return;
 const media=matchMedia('(min-width:750px)');
 const align=()=>{
  if(!media.matches){brochure.style.removeProperty('--ft-brochure-image-width');return;}
  const width=reference.getBoundingClientRect().right-brochure.getBoundingClientRect().left;
  if(width>0)brochure.style.setProperty('--ft-brochure-image-width',width+'px');
 };
 align();
 if('ResizeObserver'in window){const observer=new ResizeObserver(align);observer.observe(reference);observer.observe(brochure);}else window.addEventListener('resize',align);
 media.addEventListener('change',align);
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});else init();
})();
</script>
