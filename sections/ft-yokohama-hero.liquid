<style>
@media(min-width:750px){.ft-yoko-hero__left{min-height:375px}.ft-yoko-hero__inner{padding-bottom:16px}.ft-yoko-hero__form-card{transform:translateY(24px)}.ft-yoko-hero__background{height:calc(100% - 16px)}}
@media(min-width:750px) and (max-width:1199px){.ft-yoko-hero__left{min-height:400px}}
@media(max-width:749px){.ft-yoko-hero__left{min-height:390px}.ft-yoko-hero__background{height:calc(100% - 24px)}}
</style>

<style>
.ft-yoko-hero__overlay{background:linear-gradient(90deg,rgba(0,0,0,.94) 0%,rgba(0,0,0,.87) 40%,rgba(0,0,0,.58) 75%,rgba(0,0,0,.46) 100%)}
@media(max-width:749px){.ft-yoko-hero__overlay{background:linear-gradient(180deg,rgba(0,0,0,.91),rgba(0,0,0,.82))}}
</style>

<style>
.ft-yoko-hero__overlay{background:linear-gradient(90deg,rgba(0,0,0,.96) 0%,rgba(0,0,0,.91) 40%,rgba(0,0,0,.66) 75%,rgba(0,0,0,.54) 100%)}
@media(max-width:749px){.ft-yoko-hero__overlay{background:linear-gradient(180deg,rgba(0,0,0,.95),rgba(0,0,0,.885))}}
</style>

<style>
.ft-yoko-hero .ft-yoko-hero__form-card{background:#f3f3f3;border-radius:0}
.ft-yoko-hero .ft-yoko-hero__field input,.ft-yoko-hero .ft-yoko-hero__field textarea,.ft-yoko-hero .ft-yoko-hero__submit{border-radius:0}
</style>

<style>
.ft-yoko-hero .ft-yoko-hero__field input,.ft-yoko-hero .ft-yoko-hero__field textarea,.ft-yoko-hero .ft-yoko-hero__submit{border-radius:5px}
</style>

<style>.ft-yoko-hero .ft-yoko-hero__form-card{background:#fff}</style>

<style>
.ft-yoko-hero__image{filter:brightness(.88)}
</style>

<style>.ft-yoko-hero__background{box-shadow:0 10px 22px rgba(0,0,0,.22)}</style>

<style>.ft-yoko-hero .ft-yoko-hero__form-card{border-radius:10px}@media(max-width:749px){.ft-yoko-hero .ft-yoko-hero__form-card{border-radius:9px}}</style>

<style>
@media screen and (max-width:749px){
  .ft-yoko-hero__left{position:relative;isolation:isolate;padding-bottom:40px}
  .ft-yoko-hero__left .ft-yoko-hero__background{top:0;left:50%;right:auto;width:100vw;height:100%;transform:translateX(-50%);z-index:-1}
  .ft-yoko-hero__left .ft-yoko-hero__image{position:absolute;top:50%;bottom:auto;left:0;width:100%;height:176%;max-width:none;object-fit:cover;object-position:center;transform:translateY(-56%) scaleX(-1)}
  .ft-yoko-hero__form-card{margin-top:-16px;transform:none}
}
</style>

<style>
@media screen and (min-width:750px){
  .ft-yoko-hero__left .ft-yoko-hero__background{top:0;left:50%;right:auto;width:100vw;height:calc(100% - 16px);transform:translateX(-50%);z-index:-1}
}
@media screen and (max-width:749px){
  .ft-yoko-hero__certification .ft-yoko-hero__title{font-size:calc(var(--font-heading-scale)*3.6rem)}
}
</style>

<style>.ft-yoko-hero__title{text-transform:uppercase}</style>

{% schema %}
{
  "name": "Yokohama hero and quote",
  "settings": [
    {
      "type": "text",
      "id": "intro",
      "label": "Hero introduction"
    },
    {
      "type": "text",
      "id": "quote_heading",
      "label": "Quote heading"
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name label"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message label"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit label"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt"
    }
  ]
}
{% endschema %}
