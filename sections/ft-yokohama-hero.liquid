
{% assign hero_title = collection.title | default: 'Yokohama Pneumatic Fenders' %}
{% if theme.role == 'development' and request.locale.iso_code != 'da' and request.locale.iso_code != 'en' and request.locale.iso_code != 'de' and request.locale.iso_code != 'es' and request.locale.iso_code != 'fr' and request.locale.iso_code != 'it' and request.locale.iso_code != 'nl' and request.locale.iso_code != 'nb' and request.locale.iso_code != 'sv' %}
  {% assign legacy_collection = collections['yokohama-type-pneumatic-fenders'] %}
  {% assign hero_title = legacy_collection.title | default: hero_title %}
{% endif %}

<div class="ft-yoko-hero">


  <div class="page-width ft-yoko-hero__inner">

    <!-- LEFT CONTENT -->
    <div class="ft-yoko-hero__left">
  <!-- FULL-WIDTH HERO IMAGE -->
  <div class="ft-yoko-hero__background">
    <img
      src="{{ 'yokohama-fender-stock-hero.jpg' | asset_url }}"
      alt="{% if request.locale.iso_code == 'da' or request.locale.iso_code == 'en' or request.locale.iso_code == 'de' or request.locale.iso_code == 'fr' or request.locale.iso_code == 'es' or request.locale.iso_code == 'it' or request.locale.iso_code == 'nl' or request.locale.iso_code == 'nb' or request.locale.iso_code == 'sv' %}{{ 'fendertec_yokohama.hero.image_alt' | t }}{% else %}{{ section.settings.image_alt | escape }}{% endif %}"
      loading="eager"
      fetchpriority="high"
      class="ft-yoko-hero__image"
      width="1179" height="876"
    >
    <div class="ft-yoko-hero__overlay"></div>
  </div>


      <!-- PRODUCT INTRODUCTION -->
      <div class="ft-yoko-hero__certification">
        <h1 class="ft-yoko-hero__title h0">{{ hero_title | escape }}</h1>
        <div class="ft-yoko-hero__standard">
          <span class="ft-yoko-hero__iso-text">{% if request.locale.iso_code == 'da' or request.locale.iso_code == 'en' or request.locale.iso_code == 'de' or request.locale.iso_code == 'fr' or request.locale.iso_code == 'es' or request.locale.iso_code == 'it' or request.locale.iso_code == 'nl' or request.locale.iso_code == 'nb' or request.locale.iso_code == 'sv' %}{{ 'fendertec_yokohama.hero.intro' | t }}{% else %}{{ section.settings.intro | escape }}{% endif %}</span>
          <img
            class="ft-yoko-hero__iso-logo"
            src="{{ 'iso-17357-hero.webp' | asset_url }}"
            alt=""
            width="1122"
            height="1402"
            decoding="async"
            fetchpriority="low"
          >
        </div>
      </div>

    </div>

    <!-- RIGHT QUOTE FORM -->
    <div class="ft-yoko-hero__form-card">

      <div class="ft-yoko-hero__form-header">
        <h3 class="h3">{% if request.locale.iso_code == 'da' or request.locale.iso_code == 'en' or request.locale.iso_code == 'de' or request.locale.iso_code == 'fr' or request.locale.iso_code == 'es' or request.locale.iso_code == 'it' or request.locale.iso_code == 'nl' or request.locale.iso_code == 'nb' or request.locale.iso_code == 'sv' %}{{ 'fendertec_yokohama.hero.quote_heading' | t }}{% else %}{{ section.settings.quote_heading | escape }}{% endif %}</h3>
        
      </div>

      {% form 'contact', id: 'FenderTecYokohamaQuote', data-ft-quote-theme-role: theme.role %}

        {% if form.posted_successfully? %}
          <div class="ft-yoko-hero__success" role="status" data-ft-quote-success>
            {% if request.locale.iso_code == 'da' or request.locale.iso_code == 'en' or request.locale.iso_code == 'de' or request.locale.iso_code == 'fr' or request.locale.iso_code == 'es' or request.locale.iso_code == 'it' or request.locale.iso_code == 'nl' or request.locale.iso_code == 'nb' or request.locale.iso_code == 'sv' %}{{ 'fendertec_yokohama.hero.success_message' | t }}{% else %}{{ section.settings.success_message | escape }}{% endif %}
          </div>
        {% endif %}

        {% if form.errors %}
          <div class="ft-yoko-hero__error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <input
          type="hidden"
          name="contact[Product interest]"
          value="{{ hero_title | escape }}"
        >

        <div class="ft-yoko-hero__form-grid">

          <div class="ft-yoko-hero__field">
            <label class="visually-hidden" for="ft-yoko-name">{% if request.locale.iso_code == 'da' or request.locale.iso_code == 'en' or request.locale.iso_code == 'de' or request.locale.iso_code == 'fr' or request.locale.iso_code == 'es' or request.locale.iso_code == 'it' or request.locale.iso_code == 'nl' or request.locale.iso_code == 'nb' or request.locale.iso_code == 'sv' %}{{ 'fendertec_yokohama.hero.name_label' | t }}{% else %}{{ section.settings.name_label | escape }}{% endif %}</label>
            <input
              id="ft-yoko-name"
              type="text"
              name="contact[name]"
              value="{{ form.name | escape }}"
              autocomplete="name"
              placeholder="{% if request.locale.iso_code == 'da' or request.locale.iso_code == 'en' or request.locale.iso_code == 'de' or request.locale.iso_code == 'fr' or request.locale.iso_code == 'es' or request.locale.iso_code == 'it' or request.locale.iso_code == 'nl' or request.locale.iso_code == 'nb' or request.locale.iso_code == 'sv' %}{{ 'fendertec_yokohama.hero.name_label' | t }}{% else %}{{ section.settings.name_label | escape }}{% endif %}"
              required
            >
          </div>

          

          <div class="ft-yoko-hero__field">
            <label class="visually-hidden" for="ft-yoko-email">{% if request.locale.iso_code == 'da' or request.locale.iso_code == 'en' or request.locale.iso_code == 'de' or request.locale.iso_code == 'fr' or request.locale.iso_code == 'es' or request.locale.iso_code == 'it' or request.locale.iso_code == 'nl' or request.locale.iso_code == 'nb' or request.locale.iso_code == 'sv' %}{{ 'fendertec_yokohama.hero.email_label' | t }}{% else %}{{ section.settings.email_label | escape }}{% endif %}</label>
            <input
              id="ft-yoko-email"
              type="email"
              name="contact[email]"
              value="{{ form.email | escape }}"
              autocomplete="email"
              placeholder="{% if request.locale.iso_code == 'da' or request.locale.iso_code == 'en' or request.locale.iso_code == 'de' or request.locale.iso_code == 'fr' or request.locale.iso_code == 'es' or request.locale.iso_code == 'it' or request.locale.iso_code == 'nl' or request.locale.iso_code == 'nb' or request.locale.iso_code == 'sv' %}{{ 'fendertec_yokohama.hero.email_label' | t }}{% else %}{{ section.settings.email_label | escape }}{% endif %}"
              required
            >
          </div>

          

          <div class="ft-yoko-hero__field ft-yoko-hero__field--full">
            <label class="visually-hidden" for="ft-yoko-message">{% if request.locale.iso_code == 'da' or request.locale.iso_code == 'en' or request.locale.iso_code == 'de' or request.locale.iso_code == 'fr' or request.locale.iso_code == 'es' or request.locale.iso_code == 'it' or request.locale.iso_code == 'nl' or request.locale.iso_code == 'nb' or request.locale.iso_code == 'sv' %}{{ 'fendertec_yokohama.hero.message_label' | t }}{% else %}{{ section.settings.message_label | escape }}{% endif %}</label>
            <textarea
              id="ft-yoko-message"
              name="contact[body]"
              rows="3"
              placeholder="{% if request.locale.iso_code == 'da' or request.locale.iso_code == 'en' or request.locale.iso_code == 'de' or request.locale.iso_code == 'fr' or request.locale.iso_code == 'es' or request.locale.iso_code == 'it' or request.locale.iso_code == 'nl' or request.locale.iso_code == 'nb' or request.locale.iso_code == 'sv' %}{{ 'fendertec_yokohama.hero.message_label' | t }}{% else %}{{ section.settings.message_label | escape }}{% endif %}"
            >{{ form.body | escape }}</textarea>
          </div>

        </div>

        <button
          type="submit"
          class="ft-yoko-hero__submit"
        >
          {% if request.locale.iso_code == 'da' or request.locale.iso_code == 'en' or request.locale.iso_code == 'de' or request.locale.iso_code == 'fr' or request.locale.iso_code == 'es' or request.locale.iso_code == 'it' or request.locale.iso_code == 'nl' or request.locale.iso_code == 'nb' or request.locale.iso_code == 'sv' %}{{ 'fendertec_yokohama.hero.submit_label' | t }}{% else %}{{ section.settings.submit_label | escape }}{% endif %}
          
        </button>

      {% endform %}

    </div>

  </div>
</div>

<style>
  /* OUTER FULL-WIDTH SECTION */
  .ft-yoko-hero {
    position: relative;
    isolation: isolate;
    width: 100vw;
    max-width: none;
    margin-left: calc(50% - 50vw);
    margin-bottom: 35px;
    
  }

  /* HERO BACKGROUND */
  .ft-yoko-hero__background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 370px;
    overflow: hidden;
    z-index: 0;
    background: #252525;
  }

  .ft-yoko-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 48%;
    display: block;
  }

  .ft-yoko-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(0,0,0,0.75) 0%,
      rgba(0,0,0,0.55) 35%,
      rgba(0,0,0,0.20) 75%,
      rgba(0,0,0,0.12) 100%
    );
  }

  /* DAWN PAGE WIDTH */
  .ft-yoko-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 390px;
    gap: clamp(25px, 4vw, 65px);
    align-items: start;
  }

  /* LEFT SIDE */
  .ft-yoko-hero__left {
    padding-top: 72px;
    padding-bottom: 40px;
    min-width: 0;
    color: #ffffff;
  }

  .ft-yoko-hero__eyebrow {
    color: #ffffff;
    
    
    
    
    margin-bottom: 13px;
  }

  .ft-yoko-hero__title {
    color: #ffffff;
    
    
    
    max-width: 700px;
    margin: 0 0 26px;
  }

  /* BROCHURE BUTTONS */
  .ft-yoko-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 27px;
  }

  .ft-yoko-hero__button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 9px;
    padding: 12px 18px;
    min-height: 45px;
    
    
    
    border-radius: 5px;
    transition: background .2s ease, transform .2s ease;
  }

  .ft-yoko-hero__button:hover {
    transform: translateY(-2px);
  }

  .ft-yoko-hero__button--primary {
    color: #ffffff;
    background: var(--ft-brand-red);
    border: 1px solid var(--ft-brand-red);
  }

  .ft-yoko-hero__button--primary:hover {
    color: #ffffff;
    background: var(--ft-brand-red);
  }

  .ft-yoko-hero__button--outline {
    color: #ffffff;
    background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.85);
  }

  .ft-yoko-hero__button--outline:hover {
    color: #222222;
    background: #ffffff;
  }

  /* PRODUCT INTRODUCTION */
  .ft-yoko-hero__certification {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 100%;
    text-align: center;
  }

  .ft-yoko-hero__certification .ft-yoko-hero__title {
    margin: 0;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .ft-yoko-hero__standard {
    display: flex;
    flex-direction: row-reverse;
    align-items: center;
    gap: 16px;
    max-width: 100%;
    text-align: start;
  }

  .ft-yoko-hero__iso-text {
    max-width: 48ch;
    color: #ffffff;
  }

  .ft-yoko-hero__iso-logo {
    flex: none;
    display: block;
    width: 112px;
    height: auto;
  }

  /* FLOATING FORM CARD */
  .ft-yoko-hero__form-card {
    margin-top: 36px;
    background: #ffffff;
    padding: 24px;
    border-radius: 10px;
    box-shadow: 0 14px 40px rgba(0,0,0,.18);
    color: #222222;
  }

  .ft-yoko-hero__form-header {
    margin-bottom: 18px;
  }

  .ft-yoko-hero__form-header h2 {
    
    
    color: #222222;
    
    margin: 0 0 5px;
  }

  .ft-yoko-hero__form-header p {
    
    color: #777777;
    margin: 0;
  }

  /* FORM FIELDS */
  .ft-yoko-hero__form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0,1fr));
    gap: 13px 12px;
  }

  .ft-yoko-hero__field {
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: 5px;
  }

  .ft-yoko-hero__field--full {
    grid-column: 1 / -1;
  }

  .ft-yoko-hero__field label {
    color: #333333;
    
    
    
  }

  .ft-yoko-hero__field input,
  .ft-yoko-hero__field textarea {
    display: block;
    width: 100%;
    box-sizing: border-box;
    border: 1px solid #dedede;
    border-radius: 5px;
    background: #ffffff;
    color: #222222;
    
    
    padding: 10px 11px;
    outline: none;
    transition: border-color .2s ease;
  }

  .ft-yoko-hero__field input {
    height: 41px;
  }

  .ft-yoko-hero__field textarea {
    min-height: 79px;
    resize: vertical;
  }

  .ft-yoko-hero__field input:focus,
  .ft-yoko-hero__field textarea:focus {
    border-color: #8b8d8f;
    box-shadow: 0 0 0 1px #8b8d8f;
  }

  .ft-yoko-hero__field input::placeholder,
  .ft-yoko-hero__field textarea::placeholder {
    color: #999999;
    opacity: 1;
  }

  /* SUBMIT BUTTON */
  .ft-yoko-hero__submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    min-height: 45px;
    margin-top: 17px;
    border: 0;
    border-radius: 5px;
    background: var(--ft-brand-red);
    color: #ffffff;
    
    
    
    cursor: pointer;
    transition: background .2s ease;
  }

  .ft-yoko-hero__submit:hover {
    background: var(--ft-brand-red);
  }

  .ft-yoko-hero__success {
    background: #edf7ed;
    color: #20672b;
    border-radius: 4px;
    padding: 12px;
    margin-bottom: 15px;
    
  }

  .ft-yoko-hero__error {
    color: var(--ft-brand-red);
    
    margin-bottom: 15px;
  }

  /* TABLET */
  @media screen and (max-width: 989px) {
    .ft-yoko-hero__inner {
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: 25px;
    }

    .ft-yoko-hero__title {
      
    }

    .ft-yoko-hero__left {
      padding-top: 55px;
    }

    .ft-yoko-hero__buttons {
      gap: 9px;
    }

    .ft-yoko-hero__button {
      padding: 10px 12px;
      
    }
  }

  /* MOBILE */
  @media screen and (max-width: 749px) {
    .ft-yoko-hero {
      margin-bottom: 25px;
    }

    .ft-yoko-hero__background {
      height: 420px;
    }

    .ft-yoko-hero__image {
      object-position: center;
    }

    .ft-yoko-hero__overlay {
      background: linear-gradient(
        180deg,
        rgba(0,0,0,.68) 0%,
        rgba(0,0,0,.50) 100%
      );
    }

    .ft-yoko-hero__inner {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .ft-yoko-hero__left {
      width: 100%;
      min-height: 390px;
      box-sizing: border-box;
      padding-top: 48px;
      padding-bottom: 48px;
    }

    .ft-yoko-hero__eyebrow {
      
      margin-bottom: 12px;
    }

    .ft-yoko-hero__title {
      
      
      margin-bottom: 23px;
    }

    .ft-yoko-hero__buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 22px;
    }

    .ft-yoko-hero__button {
      
      min-height: 43px;
      padding: 10px 12px;
    }

    .ft-yoko-hero__certification {
      gap: 4px;
    }

    .ft-yoko-hero__standard {
      flex-direction: column;
      gap: 8px;
      text-align: center;
    }

    .ft-yoko-hero__iso-logo {
      width: 90px;
    }

    .ft-yoko-hero__form-card {
      width: 100%;
      box-sizing: border-box;
      margin-top: -20px;
      padding: 21px;
      border-radius: 9px;
    }

    .ft-yoko-hero__form-header h2 {
      
    }

    .ft-yoko-hero__form-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .ft-yoko-hero__field--full {
      grid-column: auto;
    }
  }

  @media screen and (max-width: 380px) {
    .ft-yoko-hero__background {
      height: 455px;
    }

    .ft-yoko-hero__left {
      min-height: 425px;
    }

    .ft-yoko-hero__buttons {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>

<style>
.ft-yoko-hero__title{max-width:800px;}
</style>

<style>.ft-yoko-hero__image{transform:scaleX(-1)}</style>

<style>
.ft-yoko-hero__form-header h2{}
.ft-yoko-hero input,.ft-yoko-hero textarea,.ft-yoko-hero button{}
</style>

<style>
